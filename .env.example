# Application
APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=25s

# PostgreSQL
DATABASE_URL=postgres://wager:wager@localhost:5432/wager?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_CONNECT_TIMEOUT=5s

# Migrations (applied by the API on startup when true; also available via cmd/migrate)
MIGRATIONS_ENABLED=true

# AWS SQS (LocalStack locally)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_OUTBOX_QUEUE_NAME=wager-events.fifo
SQS_OUTBOX_DLQ_NAME=wager-events-dlq.fifo
SQS_VISIBILITY_TIMEOUT=30s
SQS_WAIT_TIME=20s
SQS_MAX_MESSAGES=10
SQS_MAX_RECEIVE_COUNT=5

# OIDC / Keycloak
OIDC_ISSUER_URL=http://localhost:8090/realms/wager
OIDC_AUDIENCE=wager-api
OIDC_ROLES_CLAIM=realm_access.roles
OIDC_PROVIDER_CLAIM=provider_id
OIDC_HTTP_TIMEOUT=10s

# Workers
WORKER_POLL_INTERVAL=1s
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_BASE_BACKOFF=2s
REFERENCE_MAX_BACKOFF=5m
REFERENCE_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BASE_BACKOFF=2s
OUTBOX_MAX_BACKOFF=5m
OUTBOX_LOCK_TTL=30s
# PUBLISHER_ID defaults to publisher-<hostname>-<pid>

# Integration tests (see README; defaults target the Docker Compose network)
# TEST_DATABASE_URL=postgres://wager:wager@localhost:5432/wager?sslmode=disable
# TEST_SQS_ENDPOINT=http://localhost:4566
# TEST_OIDC_ISSUER_URL=http://localhost:8090/realms/wager
# TEST_OIDC_AUDIENCE=wager-api
